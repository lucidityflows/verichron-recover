  "info": {
    "title": "Verichron Audits API",
    "description": "The Audits Microservice API - Compliance record-keeping, immutable history, and chain of custody verification",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Audits",
      "description": "Immutable system action logs and chain verification"
    },
    {
      "name": "Internal",
      "description": "Internal endpoints for service-to-service communication"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AuditLogResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Audit log ID"
          },
          "organizationId": {
            "type": "string",
            "description": "Organization ID"
          },
          "eventId": {
            "type": "string",
            "description": "Event ID (idempotency key)"
          },
          "actorSnapshot": {
            "type": "object",
            "description": "Snapshot of the actor at time of action"
          },
          "action": {
            "type": "string",
            "description": "Action performed (e.g., ORGANIZATION.ACTIVATED)"
          },
          "targetType": {
            "type": "string",
            "description": "Target entity type (e.g., ORGANIZATION, DEBT)"
          },
          "targetId": {
            "type": "string",
            "description": "Target entity ID"
          },
          "changes": {
            "type": "object",
            "description": "Field changes (old/new values)"
          },
          "metadata": {
            "type": "object",
            "description": "Additional metadata (IP, correlation ID, etc.)"
          },
          "prevHash": {
            "type": "string",
            "description": "Hash of the previous record in the chain"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Timestamp of the action"
          }
        },
        "required": [
          "id",
          "organizationId",
          "eventId",
          "actorSnapshot",
          "action",
          "targetType",
          "targetId",
          "createdAt"
        ]
      },
      "AuditLogListResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "description": "List of audit logs",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditLogResponseDto"
            }
          },
          "total": {
            "type": "number",
            "description": "Total number of records matching the query"
          },
          "page": {
            "type": "number",
            "description": "Current page number"
          },
          "pageSize": {
            "type": "number",
            "description": "Items per page"
          },
          "totalPages": {
            "type": "number",
            "description": "Total number of pages"
          }
        },
        "required": [
          "data",
          "total",
          "page",
          "pageSize",
          "totalPages"
        ]
      },
      "AuditSystemStatsMetricsDto": {
