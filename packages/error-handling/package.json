{
  "name": "@verichron/error-handling",
  "version": "1.0.0",
  "private": true,
  "description": "Standardized error handling for Verichron monorepo",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint ."
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@verichron/eslint-config": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.6",
    "express": "^5.0.4",
    "typescript": "^5.3.3"
  }
}
