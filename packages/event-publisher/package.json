{
  "name": "@verichron/event-publisher",
  "version": "1.0.0",
  "private": true,
  "description": "Shared event publishing infrastructure for Verichron microservices",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "publish-event": "node dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@verichron/contracts": "workspace:*",
    "@verichron/enums": "workspace:*",
    "@verichron/events": "workspace:*",
    "@google-cloud/pubsub": "^4.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.11"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "typescript": "^5.3.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  }
}
