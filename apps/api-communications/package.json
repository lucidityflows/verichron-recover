{
  "name": "@verichron/api-communications",
  "version": "0.0.1",
  "description": "Communications microservice - manages events, notifications, and messaging",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "dotenv -e ../../.env.dev -- nest start --watch",
    "start:debug": "dotenv -e ../../.env.dev nest start --debug --watch",
    "start:prod": "dotenv -e ../../.env -- node dist/main",
    "lint": "eslint src/**/*.ts test/**/*.ts --fix",
    "test": "dotenv -e ../../.env.test -- jest --config ./jest.config.js",
    "test:watch": "jest --watch --config ./jest.config.js",
    "test:cov": "jest --coverage --config ./jest.config.js",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --config ./jest.config.js",
    "test:e2e": "jest --config ./src/test/jest-e2e.json",
    "generate-openapi": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/communications_db dotenv -e ../../.env.test -- ts-node -r tsconfig-paths/register src/generate-openapi.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d datasource.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d datasource.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d datasource.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d datasource.ts",
    "seed:staging": "ts-node -r tsconfig-paths/register src/seeding/seed.ts"
  },
  "dependencies": {
    "@verichron/auth": "workspace:*",
    "@verichron/contracts": "workspace:*",
    "@verichron/enums": "workspace:*",
    "@verichron/error-handling": "workspace:*",
    "@verichron/event-publisher": "workspace:*",
    "@verichron/event-subscriber": "workspace:*",
    "@verichron/events": "workspace:*",
    "@verichron/security": "workspace:*",
    "@google-cloud/pubsub": "^4.11.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/testing": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@sendgrid/mail": "^8.1.6",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "handlebars": "^4.7.8",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "nestjs-pino": "^4.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.14.1",
    "pino-http": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.10.7",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@verichron/eslint-config": "workspace:*",
    "@verichron/testing": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@swc/jest": "^0.2.36",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.4",
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^11.0.0",
    "eslint": "^9.33.0",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "zod": "^4.1.11"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}
