{
  "compilerOptions": {
    "target": "es2021",
    "module": "commonjs",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@verichron/api-client": ["../packages/api-client/src"],
      "@verichron/auth": ["../packages/auth/src"],
      "@verichron/auth-utils": ["../libs/auth-utils/src"],
      "@verichron/contracts": ["../packages/contracts/src"],
      "@verichron/enums": ["../packages/enums/src"],
      "@verichron/error-handling": ["../packages/error-handling/src"],
      "@verichron/event-publisher": ["../packages/event-publisher/src"],
      "@verichron/event-subscriber": ["../packages/event-subscriber/src"],
      "@verichron/event-orchestrator": ["../packages/event-orchestrator/src"],
      "@verichron/events": ["../packages/events/src"],
      "@verichron/security": ["../packages/security/src"],
      "@verichron/ui-auth": ["../apps/ui-auth/src"],
      "@verichron/ui-consumers": ["../apps/ui-consumers/src"],
      "@verichron/ui-managers": ["../apps/ui-managers/src"],
      "@verichron/ui-collectors": ["../apps/ui-collectors/src"],
      "@verichron/ui-ops": ["../apps/ui-ops/src"],
      "@verichron/ui-sales": ["../apps/ui-sales/src"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
