# Example environment variables. Copy this to .env for local development.

# Environment
NODE_ENV=

# Microservice Ports (set explicitly for consistency)
PORT_USERS=
PORT_ORGANIZATIONS=
PORT_DEBTS=
PORT_DEBTORS=
PORT_TRANSACTIONS=
PORT_COMMUNICATIONS=
PORT_COLLECTORS=
PORT_VOICE=
PORT_WORKFLOWS=
PORT_AUTOMATIONS=

# ============================================================================
# Google Cloud Platform (GCP) Configuration
# ============================================================================
# NOTE: Three separate GCP variables exist for different purposes:
#
# 1. PUBSUB_PROJECT_ID - Used by ALL services for Pub/Sub event infrastructure
#    Services: api-users, api-organizations, api-debts, api-debtors,
#              api-transactions, api-communications
#    Purpose: Project ID for Pub/Sub topics and subscriptions
#
# 2. PUBSUB_EMULATOR_HOST - Used by ALL services for local Pub/Sub emulator
#    Services: api-users, api-organizations, api-debts, api-debtors,
#              api-transactions, api-communications
#    Purpose: Host:port for local Pub/Sub emulator (tests/development only)
#    Note: Set to localhost:8085 for host scripts, pubsub-emulator-test:8085
#          for Docker containers
#
# 3. GCP_PROJECT_ID - Used ONLY by services with GCP APIs (Storage, Document AI)
#    Services: api-debts (Document AI), api-transactions (Cloud Storage)
#    Purpose: Project ID for GCP APIs other than Pub/Sub
#    Note: In tests, we use emulators so this may not be needed, but kept for
#          consistency with production configuration
# ============================================================================

PUBSUB_PROJECT_ID=
PUBSUB_EMULATOR_HOST=
GCP_PROJECT_ID=

LOG_LEVEL=

# Document AI Configuration (for api-debts import parsing)
# When true, uses MockParserService instead of real Document AI
DOCUMENT_AI_EMULATOR=

# Redis Configuration
# REDIS_URL: Used by api-users and api-debts (connection string format)
REDIS_URL=
# REDIS_HOST/PORT: Used by api-communications (separate host/port format)
REDIS_HOST=
REDIS_PORT=

# Database Configuration
# DATABASE_URL: Used by all services for TypeORM connection
# Note: For OpenAPI generation, this is required but won't actually connect
DATABASE_URL=

# JWT Configuration
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_TOKEN_EXPIRES_IN=
AUTH_CONTEXT_TOKEN_SECRET=

# API URLs for Service-to-Service Communication (within Docker network)
# Note: These use Docker service names for container-to-container communication
API_USERS_URL=
API_ORGANIZATIONS_URL=
API_DEBTS_URL=
API_DEBTORS_URL=
API_TRANSACTIONS_URL=
API_COMMUNICATIONS_URL=
API_COLLECTORS_URL=
API_VOICE_URL=
API_WORKFLOWS_URL=
API_AUTOMATIONS_URL=

# API-URLS for Microfrontends (browser access via localhost)
VITE_API_USERS_URL=
VITE_API_ORGANIZATIONS_URL=
VITE_API_DEBTS_URL=
VITE_API_DEBTORS_URL=
VITE_API_TRANSACTIONS_URL=
VITE_API_COMMUNICATIONS_URL=
VITE_API_COLLECTORS_URL=
VITE_API_VOICE_URL=
VITE_API_WORKFLOWS_URL=

# Dashboard URLs for Microfrontend Redirection
VITE_DASHBOARD_PLATFORM_URL=
VITE_DASHBOARD_ORGANIZATIONS_URL=
VITE_DASHBOARD_DEBTORS_URL=

# Stripe Configuration (for api-transactions)
STRIPE_SECRET_KEY=

# SendGrid Configuration (for api-communications)
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=
# Webhook verification key - generate in SendGrid console under Settings > Event Webhook
SENDGRID_WEBHOOK_PUBLIC_KEY=

# Twilio Configuration (for api-communications)
# Note: These are placeholder values for testing. Set real values to enable SMS sending.
TWILIO_ACCOUNT_SID=
TWILIO_MASTER_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM_NUMBER=
# Webhook URL - set to your public URL for signature verification (e.g., https://yourdomain.com/webhooks/twilio)
TWILIO_WEBHOOK_URL=

# ============================================================================
# Twilio VOICE Configuration (for api-voice)
# ============================================================================
# These are the credentials for the master Twilio account used for voice.
# Individual organizations will provide their own keys, which will be stored in the DB.
TWILIO_VOICE_ACCOUNT_SID=
TWILIO_VOICE_AUTH_TOKEN=
TWILIO_VOICE_API_KEY_SID=
TWILIO_VOICE_API_KEY_SECRET=
TWILIO_VOICE_OUTGOING_APP_SID=

# Base URL for this service, used for webhook validation
API_VOICE_APP_URL=

# Secret for encrypting Twilio credentials in the database (must be 32 bytes / 64 hex chars)
API_VOICE_ENCRYPTION_KEY=

# ============================================================================
# Service-to-Service Authentication Keys (Phase 1: HMAC-based)
# ============================================================================
# Each service has its own key to limit blast radius in case of compromise.
# These keys are used for HMAC-SHA256 request signing to authenticate internal
# service-to-service API calls without requiring user JWT tokens.
#
# Security: Phase 1 (Development/E2E Testing) - Security Level 7/10
# - HMAC-SHA256 request signing
# - Service-scoped keys (limits compromise blast radius)
# - Replay attack prevention (timestamp + nonce validation)
# - Constant-time signature comparison
#
# TODO Phase 2 (Pre-Production): Add Redis-backed nonce cache, rate limiting,
#      structured audit logging, and automated key rotation
# TODO Phase 3 (Production): Migrate to mTLS via Istio service mesh on GKE
#
# WARNING: These are TEST keys. NEVER use these in production.
# Production keys should be:
# - Generated with cryptographically secure random generator
# - Stored in secret management system (GCP Secret Manager, HashiCorp Vault)
# - Rotated monthly (automated)
# - Minimum 32 characters (256-bit entropy)
# ============================================================================

SERVICE_KEY_ORGANIZATIONS=
SERVICE_KEY_USERS=
SERVICE_KEY_DEBTS=
SERVICE_KEY_DEBTORS=
SERVICE_KEY_TRANSACTIONS=
SERVICE_KEY_COMMUNICATIONS=
SERVICE_KEY_COLLECTORS=
SERVICE_KEY_VOICE=
SERVICE_KEY_WORKFLOWS=
SERVICE_KEY_AUTOMATIONS=