# =============================================================================
# Payment Gateway Configuration
# =============================================================================
#
# This file documents the environment variables required for the gateways module.
# Copy values to your .env file or configure in your deployment environment.
#
# SECURITY WARNING: Never commit actual API keys to version control!
# Use GCP Secret Manager or similar for production deployments.
# =============================================================================

# -----------------------------------------------------------------------------
# Stripe Configuration
# -----------------------------------------------------------------------------

# Stripe Secret API Key
# Obtain from: https://dashboard.stripe.com/apikeys
# Format: sk_test_... (test mode) or sk_live_... (production mode)
STRIPE_SECRET_KEY=sk_test_example_placeholder_key

# Stripe Webhook Signing Secret
# Obtain from: https://dashboard.stripe.com/webhooks
# Used to verify webhook signatures and prevent spoofing
# Format: whsec_...
STRIPE_WEBHOOK_SECRET=whsec_1234567890abcdefghijklmnopqrstuvwxyz

# -----------------------------------------------------------------------------
# Future Payment Provider Configurations
# -----------------------------------------------------------------------------

# Plaid Configuration (for ACH payments)
# PLAID_CLIENT_ID=your_plaid_client_id
# PLAID_SECRET=your_plaid_secret
# PLAID_ENV=sandbox|development|production

# PayPal Configuration
# PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# PAYPAL_MODE=sandbox|live

# -----------------------------------------------------------------------------
# Gateway Settings
# -----------------------------------------------------------------------------

# Default currency for payments (ISO 4217 code)
# Default: usd
DEFAULT_PAYMENT_CURRENCY=usd

# Maximum number of retry attempts for transient gateway errors
# Default: 3
GATEWAY_MAX_RETRIES=3

# Base delay for exponential backoff retries (milliseconds)
# Default: 1000 (1 second)
GATEWAY_RETRY_DELAY_MS=1000

# -----------------------------------------------------------------------------
# Webhook Configuration
# -----------------------------------------------------------------------------

# Public URL for webhook endpoints (production only)
# Used by payment gateways to send event notifications
# Format: https://yourdomain.com
# Example webhook URL: https://yourdomain.com/gateways/stripe/webhooks
WEBHOOK_BASE_URL=https://api.yourdomain.com

# -----------------------------------------------------------------------------
# Development/Testing Notes
# -----------------------------------------------------------------------------
#
# 1. Test Mode Keys:
#    - Use test mode keys (sk_test_...) for development and testing
#    - Test mode cards: https://stripe.com/docs/testing
#
# 2. Webhook Testing:
#    - Use Stripe CLI for local webhook testing:
#      stripe listen --forward-to localhost:3005/gateways/stripe/webhooks
#    - Get webhook signing secret from CLI output
#
# 3. Production Deployment:
#    - Store secrets in GCP Secret Manager
#    - Use live mode keys (sk_live_...)
#    - Configure webhook endpoints in Stripe Dashboard
#    - Enable webhook signature verification
#
# =============================================================================