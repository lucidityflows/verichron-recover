{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Default",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "inlineSources": false,
    "isolatedModules": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "preserveWatchOutput": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@verichron/api-client": ["../../packages/api-client/dist"],
      "@verichron/auth": ["../../packages/auth/dist"],
      "@verichron/auth-utils": ["../../libs/auth-utils/dist"],
      "@verichron/contracts": ["../../packages/contracts/dist"],
      "@verichron/enums": ["../../packages/enums/dist"],
      "@verichron/error-handling": ["../../packages/error-handling/dist"],
      "@verichron/event-publisher": ["../../packages/event-publisher/dist"],
      "@verichron/event-subscriber": ["../../packages/event-subscriber/dist"],
      "@verichron/event-orchestrator": ["../../packages/event-orchestrator/dist"],
      "@verichron/events": ["../../packages/events/dist"],
      "@verichron/security": ["../../packages/security/dist"],
      "@verichron/ui-auth": ["../../apps/ui-auth"],
      "@verichron/ui-consumers": ["../../apps/ui-consumers"],
      "@verichron/ui-managers": ["../../apps/ui-managers"],
      "@verichron/ui-collectors": ["../../apps/ui-collectors"],
      "@verichron/ui-ops": ["../../apps/ui-ops"],
      "@verichron/ui-sales": ["../../apps/ui-sales"]
    }
  },
  "exclude": ["node_modules", "dist"]
}