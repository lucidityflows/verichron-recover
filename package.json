{
  "name": "recover",
  "private": true,
  "version": "1.0.0",
  "description": "Debt Collection Management Platform",
  "scripts": {
    "api:rm:dist": "sudo rm -rf ./apps/api/dist",
    "dev": "pnpm --parallel --stream -r dev",
    "dev:api": "pnpm --filter @verichron/api start:dev",
    "dev:ui": "pnpm --filter @verichron/web dev",
    "dev:ui:all": "concurrently -n \"auth,ops,managers,collectors,consumers,marketing\" -c \"cyan,magenta,green,yellow\" \"pnpm --filter @verichron/ui-auth dev\" \"pnpm --filter @verichron/ui-ops dev\" \"pnpm --filter @verichron/ui-managers dev\" \"pnpm --filter @verichron/ui-collectors dev\" \"pnpm --filter @verichron/ui-consumers dev\" \"pnpm --filter @verichron/ui-marketing dev\"",
    "dev:sales": "pnpm --filter @verichron/ui-sales dev",
    "dev:stack": "concurrently \"pnpm docker:dev\" \"pnpm dev:api\" \"pnpm dev:ui\"",
    "dev:local": "sudo docker compose up --build",
    "dev:local:down": "sudo docker compose down",
    "dev:local:logs": "sudo docker compose logs -f",
    "event:publish": "pnpm --filter @verichron/event-publisher start",
    "docker:dev:build": "UID=$(id -u) GID=$(id -g) sudo docker compose -f docker-compose.dev.yml build --no-cache",
    "docker:dev": "UID=$(id -u) GID=$(id -g) sudo docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "sudo docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "sudo docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:ps": "sudo docker compose -f docker-compose.dev.yml ps",
    "db:seed": "pnpm --filter @verichron/tools seed",
    "db:seed:test": "pnpm --filter @verichron/tools seed:test",
    "db:seed:users": "pnpm --filter @verichron/tools seed:users",
    "db:seed:debts": "pnpm --filter @verichron/tools seed:debts",
    "db:seed:organizations": "pnpm --filter @verichron/tools seed:organizations",
    "db:seed:debtors": "pnpm --filter @verichron/tools seed:debtors",
    "db:seed:communications": "pnpm --filter @verichron/tools seed:communications",
    "db:seed:transactions": "pnpm --filter @verichron/tools seed:transactions",
    "generate-openapi": "pnpm --parallel --stream -r --filter @verichron/api-* --filter '!@verichron/api-automations' generate-openapi",
    "api:generate": "pnpm generate-openapi && pnpm api:types",
    "api:types": "openapi-typescript openapi.json -o generated/api-types/src/index.ts",
    "audit:start": "pnpm --filter @verichron/tools start:audit",
    "audit:clean": "pnpm --filter @verichron/tools start:audit:clean",
    "deps:start": "pnpm --filter @verichron/tools start:deps",
    "deps:fix": "pnpm --filter @verichron/tools start:deps:fix",
    "depcheck:start": "pnpm -r exec depcheck --quiet",
    "build:ui-theming:css": "npx tailwindcss -i ./libs/ui-theming/src/globals.css -o ./libs/ui-theming/dist/globals.css --minify",
    "build": "tsc -b tsconfig.solution.json --verbose --force",
    "build:demo": "APP_MODE=demo pnpm --filter @verichron/web build",
    "build:sales": "pnpm --filter @verichron/sales build",
    "build:stage": "APP_MODE=stage pnpm -r build",
    "test": "pnpm -r test",
    "e2e": "ts-node e2e/cli.ts",
    "e2e:setup": "ts-node e2e/cli.ts setup",
    "e2e:teardown": "ts-node e2e/cli.ts teardown",
    "e2e:status": "ts-node e2e/cli.ts status",
    "e2e:reset": "ts-node e2e/cli.ts reset",
    "e2e:logs": "ts-node e2e/cli.ts logs",
    "e2e:test": "ts-node e2e/cli.ts test",
    "e2e:clean": "ts-node e2e/cli.ts clean",
    "test:e2e:users": "pnpm --filter @verichron/api-users test:e2e",
    "lint": "pnpm -r lint",
    "clean": "pnpm audit:clean && pnpm install",
    "clean:types": "find . -type f \\( -name '*.d.ts' -o -name '*.d.ts.map' -o -name 'tsconfig.tsbuildinfo' \\) -not -path '*/node_modules/*' -delete",
    "install:all": "pnpm install",
    "clean:dist": "sudo find . -type d -name 'dist' -exec rm -rfi {} +"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/jsdom": "^27.0.0",
    "concurrently": "^8.2.2",
    "depcheck": "^1.4.7",
    "dotenv-cli": "^10.0.0",
    "pnpm": "^9.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.27",
    "typescript": "^5.0.0",
    "zod": "^4.6.6",
    "@tailwindcss/cli": "^4.0.8",
    "tailwindcss": "^4.1.13",
    "@tanstack/react-query": "^5.89.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.544.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "@types/node": "^22.13.11",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^9.33.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/jwt": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14"
  },
  "dependencies": {
    "@nestjs/core": "^11.1.6",
    "bcrypt": "^5.1.1"
  }
}
