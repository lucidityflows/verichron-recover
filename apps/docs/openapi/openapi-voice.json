  "info": {
    "title": "Verichron Voice API",
    "description": "The Voice Microservice API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateTwilioConfigDto": {
        "type": "object",
        "properties": {
          "accountSid": {
            "type": "string",
            "description": "Twilio Account SID",
            "example": "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
          },
          "authToken": {
            "type": "string",
            "description": "Twilio Auth Token",
            "example": "your_auth_token"
          },
          "apiKeySid": {
            "type": "string",
            "description": "Twilio API Key SID",
            "example": "SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
          },
          "apiKeySecret": {
            "type": "string",
            "description": "Twilio API Key Secret",
            "example": "your_api_key_secret"
          },
          "outgoingApplicationSid": {
            "type": "string",
            "description": "Twilio TwiML App SID for outgoing calls",
            "example": "APxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
          }
        },
        "required": [
          "accountSid",
          "authToken",
          "apiKeySid",
          "apiKeySecret",
          "outgoingApplicationSid"
        ]
      },
      "TwilioConfigResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique ID of the Twilio configuration",
            "example": "a1b2c3d4-e5f6-7890-1234-567890abcdef"
          },
          "organizationId": {
            "type": "string",
            "description": "ID of the organization this configuration belongs to",
            "example": "a1b2c3d4-e5f6-7890-1234-567890abcdef"
          },
          "accountSid": {
            "type": "string",
            "description": "Twilio Account SID",
            "example": "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
          },
          "apiKeySid": {
            "type": "string",
            "description": "Twilio API Key SID",
            "example": "SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
          },
          "outgoingApplicationSid": {
            "type": "string",
            "description": "Twilio TwiML App SID for outgoing calls",
            "example": "APxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Date when the configuration was created",
            "example": "2023-10-27T10:00:00.000Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "description": "Date when the configuration was last updated",
            "example": "2023-10-27T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "organizationId",
          "accountSid",
          "apiKeySid",
          "outgoingApplicationSid",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateTwilioConfigDto": {
        "type": "object",
        "properties": {
          "accountSid": {
            "type": "string",
            "description": "Twilio Account SID",
            "example": "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
          },
          "authToken": {
            "type": "string",
            "description": "Twilio Auth Token",
            "example": "your_auth_token"
          },
          "apiKeySid": {
            "type": "string",
            "description": "Twilio API Key SID",
            "example": "SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
          },
          "apiKeySecret": {
            "type": "string",
            "description": "Twilio API Key Secret",
            "example": "your_api_key_secret"
          },
          "outgoingApplicationSid": {
            "type": "string",
            "description": "Twilio TwiML App SID for outgoing calls",
            "example": "APxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
          }
        }
      },
      "InitiateCallDto": {
        "type": "object",
        "properties": {
          "debtorId": {
            "type": "string",
            "description": "The UUID of the debtor to call",
            "example": "a1b2c3d4-e5f6-7890-1234-567890abcdef"
          },
          "phoneNumber": {
            "type": "string",
            "description": "The phone number to call",
            "example": "+15551234567"
          }
        },
        "required": [
          "debtorId",
          "phoneNumber"
        ]
      },
      "StatusCallbackDto": {
        "type": "object",
        "properties": {
          "CallSid": {
            "type": "string"
          },
          "AccountSid": {
            "type": "string"
          },
          "From": {
            "type": "string"
          },
          "To": {
            "type": "string"
          },
          "CallStatus": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RINGING",
              "IN_PROGRESS",
              "COMPLETED",
              "FAILED",
              "CANCELED",
              "NO_ANSWER",
              "BUSY"
            ]
          },
          "CallDuration": {
            "type": "string"
          },
          "RecordingUrl": {
            "type": "string"
          },
          "RecordingSid": {
            "type": "string"
          },
          "RecordingDuration": {
            "type": "string"
          }
        },
        "required": [
          "CallSid",
          "AccountSid",
          "From",
          "To",
          "CallStatus"
        ]
      },
      "SandboxCallDto": {
        "type": "object",
        "properties": {
          "toNumber": {
            "type": "string",
            "description": "Phone number to call (E.164 format)",
            "example": "+12125551234"
          },
          "message": {
            "type": "string",
            "description": "Message to say (Text-to-Speech)",
            "example": "This is a test call from the Debt Lucidity QA Sandbox."
          }
        },
        "required": [
          "toNumber"
        ]
      },
      "SandboxCallResponseDto": {
        "type": "object",
        "properties": {
          "sid": {
            "type": "string",
            "description": "Twilio Call SID"
          },
          "status": {
            "type": "string",
            "description": "Current call status"
          },
          "direction": {
            "type": "string",
            "description": "Call direction"
          },
          "from": {
            "type": "string",
            "description": "Caller number"
          },
          "to": {
            "type": "string",
            "description": "Recipient number"
          },
          "success": {
            "type": "boolean",
            "description": "Whether the call was successful"
          },
          "error": {
            "type": "string",
            "description": "Error message if call failed"
          }
        }
      }
    }
  }
}